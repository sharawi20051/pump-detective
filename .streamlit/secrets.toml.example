# Developer settings for the optional AI writer. Users never see or type these.
# Local use: copy this file to .streamlit/secrets.toml (git-ignored) and fill in ONE of the keys.
# Streamlit Community Cloud: paste the same lines into the app's Settings -> Secrets.
# Without a key, the app uses the offline (rule-based) writer and shows no AI option.

# Option 1: Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-gemini-key-here"
# GEMINI_MODEL = "gemini-flash-latest"

# Option 2: OpenAI (paid API, separate from a ChatGPT subscription). Used instead of Gemini if set.
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-6-luna"
